model Payment{
    id   String    @id  @default(uuid(7))
    amount  Float    
    trnsactionId    String    @unique
    status   PaymentStatus   @default(UNPAID)
    paymentGatewayData     Json?
    createdAT         DateTime  @default(now())
    updatedAt        DateTime   @updatedAt


    appointmentId   String    @unique
    appointemt   Appointment   @relation(fields: [appointmentId],references: [id],onDelete: Cascade)

    @@index([appointmentId])
    @@index([trnsactionId])
    @@map("payments")
}